---
interface Props {
  title: string;
  tagline: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const {
  title,
  tagline,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="folio-hero not-content">
  <h1>{title}</h1>
  <p class="tagline">{tagline}</p>
  <div class="actions">
    <a class="btn btn-primary" href={primaryHref}>{primaryLabel} →</a>
    {secondaryHref && (
      <a class="btn" href={secondaryHref}>
        <span class="mono">{secondaryLabel}</span>
      </a>
    )}
  </div>
</section>
