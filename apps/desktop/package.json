{
  "name": "folio-desktop",
  "private": true,
  "version": "0.1.3",
  "description": "Electron wrapper for the Folio Viewer (FastAPI + React).",
  "author": {
    "name": "Folio",
    "email": "noreply@github.com",
    "url": "https://github.com/nyuta01/folio"
  },
  "homepage": "https://github.com/nyuta01/folio",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist node_modules out",
    "start": "electron dist/main/main.js",
    "dev": "npm run build && npm run start",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.folio.desktop",
    "productName": "Folio",
    "copyright": "Folio contributors",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/__tests__/**",
      "!**/*.tsbuildinfo"
    ],
    "extraResources": [
      {
        "from": "../../viewer/dist",
        "to": "viewer-dist",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Development",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    }
  }
}
